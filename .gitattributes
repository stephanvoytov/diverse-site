# Auto-detect text files
* text=auto

# Force LF for all text files (consistent across Windows/macOS/Linux)
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.html     text eol=lf
*.mjs      text eol=lf
*.env*     text eol=lf

# Binary files — no line-ending conversion
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.svg      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
